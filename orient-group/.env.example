# Public URL of the live site (used for canonical URLs, sitemap.xml and Open Graph).
NEXT_PUBLIC_SITE_URL=https://orientgroupkwt.com

# Search engine indexing. Anything other than "true" (or leaving it unset) makes every page
# noindex, nofollow and robots.txt "Disallow: /". Set to "true" only when the site goes live.
# Read at build time: redeploy after changing it.
NEXT_PUBLIC_ALLOW_INDEXING=false
