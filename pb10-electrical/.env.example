# Public URL of the deployed site (no trailing slash) — used for the canonical link and social-share image.
VITE_SITE_URL=https://example.com

# Quote form: set ONE of these (see README → Contact form).
# Any service that accepts a JSON POST works (Formspree, Web3Forms, Getform…).
VITE_FORM_ENDPOINT=
# Fallback if no endpoint: opens the visitor's email app addressed to this email.
VITE_CONTACT_EMAIL=
